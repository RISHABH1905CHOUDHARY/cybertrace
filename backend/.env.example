# CrimeTrace AI Backend Configuration

# Application
APP_NAME=CrimeTrace AI Backend
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=crimetrace-super-secret-jwt-signing-key-change-in-production-min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
# For PostgreSQL with PostGIS (production / docker-compose):
DATABASE_URL=postgresql+asyncpg://crimetrace:crimetrace_secret@localhost:5432/crimetrace_db
# Sync DB URL for Alembic migrations if needed:
SYNC_DATABASE_URL=postgresql+psycopg2://crimetrace:crimetrace_secret@localhost:5432/crimetrace_db

# Toggle PostGIS geometry columns (true if PostGIS extension is installed, false to use standard float lat/lon fallback):
USE_POSTGIS=false

# Security & CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ML Service Settings
ML_MODEL_ENABLED=false
ML_SERVICE_STUB_MODE=true
ML_MODEL_PATH=app/ml/weights/withdrawal_predictor.onnx
